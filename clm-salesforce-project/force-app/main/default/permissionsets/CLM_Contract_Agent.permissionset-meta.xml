<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>What the Contract Copilot agent user needs to run its actions: execute ClmContractPackage, and read the contract and its Box folder association. Without the class access the action is not offered to the planner at all. Read only.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>CLM Contract Agent</label>
    <classAccesses>
        <apexClass>ClmBoxAskDocument</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ClmContractPackage</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Box_Workspace_Folder_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Contract_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Counterparty__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Risk_Level__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>box__FRUP__c.box__Folder_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>box__FRUP__c.box__Record_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>CLM_Contract__c</object>
        <!--
          View All on this one object, for this one user. The agent owns no contracts and
          is shared none, and CLM_Contract__c is Private/Private, so a record-scoped read
          returns nothing and the conversation reports "I could not find that contract",
          which reads as a bad reference rather than as a permission boundary. Read only,
          and answering about contracts it is asked about is the agent's whole purpose.
        -->
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>box__FRUP__c</object>
        <!--
          The Box for Salesforce record-to-folder association. Without read here the agent
          user cannot even name the object: Apex raises "sObject type box__FRUP__c is not
          supported", the action fails, and the conversation reports a system error.
        -->
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>UserExternalCredential</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>CLM_Box-CLM_Box_Principal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
</PermissionSet>
