<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Least-privilege guest access to the Box preview token endpoint: ClmBoxTokenService and the CLM_Box credential principal only. CLM_Demo_Operator cannot be assigned to a guest user; its CLM_Contract__c permissions are disallowed by that license.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>CLM Box Preview Guest</label>
    <classAccesses>
        <apexClass>ClmBoxTokenService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>UserExternalCredential</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>CLM_Box-CLM_Box_Principal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
</PermissionSet>
