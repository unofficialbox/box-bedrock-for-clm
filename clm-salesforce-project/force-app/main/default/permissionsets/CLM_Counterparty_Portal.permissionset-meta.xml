<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Read on the contract fields the counterparty list renders, and nothing more. Risk_Level__c is deliberately absent: it is Acme&apos;s own assessment, not a fact about the contract. Rows are filtered by the sharing set on Counterparty_Account__c.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>CLM Counterparty Portal</label>
    <classAccesses>
        <apexClass>ClmBoxTokenService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ClmCounterpartyContracts</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ClmWhoAmI</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Contract_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Counterparty_Account__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.End_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Term_Months__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Box_Workspace_Folder_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Contract_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Counterparty_Entity__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Counterparty__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Deal_Value__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!--
      Apex REST is what mints the Box token, and a call to /services/apexrest is refused
      with a bare 403 unless the caller has API Enabled. The Customer Community profile
      does not grant it. That is why the workspace could list contracts and then fail to
      load a single document: the GraphQL UI API goes through the site's own bridge and
      needs no such permission, so one path worked while the other did not.

      It widens nothing this user can reach. API Enabled governs whether the platform will
      answer them at all, not what it answers with; every call is still bounded by the
      object read, the eight fields, and the sharing set below.
    -->
    <userPermissions>
        <enabled>true</enabled>
        <name>ApiEnabled</name>
    </userPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>CLM_Contract__c</object>
        <!--
          Object read only. No records are shared with a counterparty, so this grants the
          ability to run the query, not the ability to see anybody's rows. The account
          filter inside ClmCounterpartyContracts is what decides which rows come back.
        -->
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <!--
      Minting the Box token is a callout under the org's Client Credentials Grant, and Apex
      cannot use that credential on a user's behalf unless the user is granted the
      principal. Without both of these the endpoint is reached, runs, and throws
      System.CalloutException, which surfaces to the browser as box_request_failed with no
      indication that a permission is missing. CLM_Box_Preview_Guest and CLM_Contract_Agent
      both carry the same pair for the same reason.
    -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>UserExternalCredential</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>CLM_Box-CLM_Box_Principal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
</PermissionSet>
