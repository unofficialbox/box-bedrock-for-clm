<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Read on the contract fields the counterparty list renders, and nothing more. Risk_Level__c is deliberately absent: it is Acme&apos;s own assessment, not a fact about the contract. Rows are filtered by the sharing set on Counterparty_Account__c.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>CLM Counterparty Portal</label>
    <classAccesses>
        <apexClass>ClmBoxTokenService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ClmCounterpartyContracts</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Contract_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Counterparty_Account__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Term_Months__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Box_Workspace_Folder_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Contract_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Counterparty__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CLM_Contract__c.Deal_Value__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>CLM_Contract__c</object>
        <!--
          Object read only. No records are shared with a counterparty, so this grants the
          ability to run the query, not the ability to see anybody's rows. The account
          filter inside ClmCounterpartyContracts is what decides which rows come back.
        -->
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
