                "requesterEmail" = "<formField:requesterEmail>"
                "requesterName" = "<formField:requesterName>"
                "specialTermsRiskNotes" = "<formField:specialTermsRiskNotes>"
                "targetSignatureDate" = "<formField:targetSignatureDate>"
                "termMonths" = "<formField:termMonths>"
              }
              "initialStatus" = "inactive"
              "key" = "contract-intake-enrichment"
              "name" = "CLM - Contract Intake Enrichment"
              "openIssues" = [
                "No Extract Agent step exists in the live draft. Earlier revisions of this file specified one as step 1; decide whether to add it back or drop it from the packaged design."
                "POST to the sobject collection has no duplicate safety. The PATCH upsert it replaced was idempotent against a Contract_ID__c external ID; this is not. Resubmitting the same contract would create a second Salesforce record. Decide on a duplicate strategy before activation."
                "The connector step captures no output variable, so the created Salesforce record ID is not retained. The verified test outcome captured it as id from $.id."
                "Risk_Level__c is no longer sent. It previously carried a fabricated literal, and the Box Agent emits unstructured text rather than a picklist value. Restore it once a structured Extract or Agent output supplies a real risk level."
                "Box substitutes the literal string 'Variable unavailable' for an unresolved variable, not an empty string. A live run on 2026-07-22 failed because the Currency and Number fields received that text. Only bind values whose Form field is mandatory."
                "The same substitution also produced a workspace folder named CLM-2026-Variable unavailable. Contract ID is required again, so the rename now resolves, but the rename step has not been re-run to confirm it."
                "The connector failure surfaced only as errorCode UNKNOWN_ERROR with an empty payload. Box does not expose the Salesforce error body, so connector faults have to be diagnosed from the request payload in the run events."
                "The connector must target the Salesforce org that actually holds CLM_Contract__c. Two similarly named connectors in this environment point at different orgs, and the wrong one fails with an opaque UNKNOWN_ERROR even when the payload is valid."
                "This workflow is Active. Any further edit saves as a draft and does not take effect until the workflow is activated again, so always confirm the published version rather than the editor contents."
                "The step uses the Agentforce Dev connector, while the verified POST was tested on Agentforce MyDomain Dev. Both resolve to the same development org host, but the POST contract has not been re-tested through this connector."
                "No Salesforce lookup step exists in the live draft, so the workflow captures no created record ID."
                "The Rejected branch has no outcome, so rejected submissions produce no notification or return-for-correction."
                "The Box Agent instructions embed the approved-clause-library folder ID as literal text, which is not portable across environments."
                "Every optional Form value can now arrive blank. The connector body must tolerate an empty string for each one before this workflow is activated."
              ]
              "optionalFormVariables" = [
                "requesterName"
                "dealValue"
                "termMonths"
                "region"
                "dataCategory"
                "targetSignatureDate"
                "businessOwner"
                "specialTermsRiskNotes"
              ]
              "placeholderConvention" = {
                "${binding}" = "Resolved by python3 scripts/demo_operator.py resolve-config from runtime state."
                "<name>" = "Resolved by hand at provisioning time. The operator tooling has no runtime binding for these yet, so they are deliberately not written as ${} bindings."
                "note" = "Box Automate's own variable tokens also use ${}. To avoid collision with the resolver, Automate expressions are stored as a template plus a token map rather than as interpolated strings."
              }
              "required" = true
              "requiredFormVariables" = [
                "requesterEmail"
                "contractPackage"
                "contractId"
                "contractType"
                "counterparty"
              ]
              "requiredFormVariablesNote" = "Reconciled twice on 2026-07-22 and published each time. First reduced to two required fields, then raised to five after a live run failed. Salesforce marks Contract_ID__c, Contract_Type__c, Counterparty__c, and Requester_Email__c required on CLM_Contract__c, so their Form sources must be mandatory. contractPackage stays required because the Box Agent, the approval task, and two connector fields all read the uploaded file. The Form was edited in place both times, never rebuilt, so element IDs are unchanged and all bindings still resolve."
              "steps" = [
                {
                  "destinationFolderId" = {
                    "type" = "variable"
                    "value" = "static.trigger.form.<formField:contractPackage>.folderId"
                  }
                  "eventSubType" = "copy"
                  "name" = "Copy the CLM workspace template into the submission folder"
                  "order" = 1
                  "outputs" = [
                    "folderId"
                  ]
                  "sourceFolderId" = "<workspaceTemplateFolderId>"
                  "type" = "Folder Action"
                }
                {
                  "eventSubType" = "rename"
                  "folderId" = {
                    "type" = "variable"
                    "value" = "static.outcome_<step1>.folderId"
                  }
                  "name" = "Name the workspace from the workflow year and Contract ID"
                  "newName" = {
                    "note" = "Stored in the editor as one interpolated string. Each token appears wrapped in a dollar sign and braces."
                    "template" = "CLM-{year}-{contractId}"
                    "tokens" = {
                      "contractId" = "static.trigger.form.<formField:contractId>"
                      "year" = "static.workflow.createdAt__YYYY__"
                    }
                  }
                  "order" = 2
                  "type" = "Folder Action"
                }
                {
                  "agentId" = "default_box_agent"
                  "agentName" = "Box Agent"
                  "agentRef" = "config/box/ai-agent-specs.bcl#contract-risk-triage"
                  "contextItems" = [
                    {
                      "type" = "variable"
                      "value" = "trigger.form.<formField:contractPackage>.fileIds"
                    }
                  ]
                  "eventSubType" = "default"
                  "expectedOutput" = [
                    "riskLevel"
                    "materialDeviations"
                    "requiredReviewers"
                    "evidenceItemIds"
                  ]
                  "instructions" = {
                    "note" = "In the live draft the clause-library folder ID is typed as a literal rather than bound, which is the portability defect recorded in openIssues."
                    "template" = "Review Box file ID {fileIds} against the approved clause library in folder ID {clauseLibraryFolderId}. Produce a concise approval brief covering risk, clause deviations, responsible reviewers, and recommended standard or approved fallback. Treat Extract output as draft and require human validation."
                    "tokens" = {
                      "clauseLibraryFolderId" = "${box.folders.clauses}"
                      "fileIds" = "static.trigger.form.<formField:contractPackage>.fileIds"
                    }
                  }
                  "name" = "CLM Contract Risk Triage"
                  "order" = 3
                  "outputFormat" = "textValue"
                  "type" = "Box Agent"
                }
                {
                  "assignees" = [
                    "${box.reviewers.primary}"
