# Box Dispatch BCL config artifact. BCL is the only supported import format.
locals {
  "bcl" = {
    "context" = "clm"
    "generatedAt" = "2026-07-23T11:55:20Z"
    "metadata" = {
    }
    "provider" = "generic"
    "resources" = [
      {
        "config" = {
          "artifact_name" = "automate-workflows"
          "artifact_type" = "config"
          "bindingModel" = "Resolve with python3 scripts/demo_operator.py resolve-config"
          "created_at" = "2026-07-23T11:55:20Z"
          "designPrinciples" = [
            "Use resolved Box content IDs rather than display names in workflow bindings."
            "Place a human validation or approval task after every generative or extractive AI result."
            "Send only allowlisted structured fields through HTTPS connectors; never send contract bytes or secrets."
            "Keep workflows inactive until trigger, permissions, OAuth, idempotency, and rollback tests pass."
          ]
          "enterprise_id" = ""
          "provider" = "generic"
          "provider_object_id" = "box/automate-workflows"
          "schemaVersion" = "2.0"
          "workflows" = [
            {
              "description" = "Trigger on applied CLM contract metadata, run the CLM intake agent, route human validation, and emit an approved integration event."
              "initialStatus" = "inactive"
              "key" = "contract-intake-enrichment"
              "name" = "CLM - Contract Intake Enrichment"
              "openIssues" = [
                "This workflow was redesigned from a Form trigger to a clmContract metadata trigger. The form-triggered variant was the one proven live on 2026-07-22; this metadata-triggered variant has not been re-verified and must be rebuilt and re-tested before activation."
                "The metadata trigger assumes the clmContract structured fields are already applied to the file. If the demo should derive them from the document, add an Extract Agent plus Apply Metadata pre-step so the connector reads populated metadata rather than blank fields."
                "Duplicate safety: the POST is not idempotent (see the connector step's duplicateStrategy). It remains the proven path; switch to the external-ID PATCH upsert plus lookup for dedup if re-triggers are expected."
                "Risk_Level__c is written only after the human validates it (see the approval task's riskLevelGate); the reviewer applies the validated value to clmContract metadata so the connector never binds raw Box Agent text into the picklist."
                "Box substitutes the literal string 'Variable unavailable' for an unresolved variable, not an empty string. A live run on 2026-07-22 failed because the Currency and Number fields received that text. Only bind values whose clmContract metadata field is guaranteed populated before the trigger fires."
                "The connector failure surfaced only as errorCode UNKNOWN_ERROR with an empty payload. Box does not expose the Salesforce error body, so connector faults have to be diagnosed from the request payload in the run events."
                "The connector must target the Salesforce org that actually holds CLM_Contract__c. Two similarly named connectors in this environment point at different orgs, and the wrong one fails with an opaque UNKNOWN_ERROR even when the payload is valid."
                "The live Active workflow is still the form-triggered version. Rebuilding it around the metadata trigger requires deactivating and re-activating, so always confirm the published version rather than the editor contents."
                "The step uses the Agentforce Dev connector, while the verified POST was tested on Agentforce MyDomain Dev. Both resolve to the same development org host, but the POST contract has not been re-tested through this connector."
                "The created record id is captured (outputVariables.recordId = $.id) but no Salesforce lookup step exists; add one only if a later step needs to re-read the record (e.g. when switching to the upsert path)."
                "The Box Agent instructions embed the approved-clause-library folder ID as literal text, which is not portable across environments."
              ]
              "optionalMetadataFields" = [
                "dealValue"
                "termMonths"
                "region"
                "dataCategory"
                "targetSignatureDate"
                "owner"
              ]
              "placeholderConvention" = {
                "${binding}" = "Resolved by python3 scripts/demo_operator.py resolve-config from runtime state."
                "<name>" = "Resolved by hand at provisioning time. The operator tooling has no runtime binding for these yet, so they are deliberately not written as ${} bindings."
                "note" = "Box Automate's own variable tokens also use ${}. To avoid collision with the resolver, Automate expressions are stored as a template plus a token map rather than as interpolated strings."
              }
              "required" = true
              "requiredMetadataFields" = [
                "contractId"
                "contractType"
                "counterparty"
                "requesterEmail"
              ]
              "requiredMetadataFieldsNote" = "Salesforce marks Contract_ID__c, Contract_Type__c, Counterparty__c, and Requester_Email__c required on CLM_Contract__c, so their clmContract metadata sources must be populated before the trigger fires. Box substitutes the literal string 'Variable unavailable' for an unresolved metadata variable, not an empty string, so an unpopulated field corrupts a typed Salesforce field rather than arriving blank. requesterEmail was added to the clmContract template for this purpose. The triggering file must also be present because the Box Agent and approval task read it."
              "steps" = [
                {
                  "destinationFolderId" = "${box.folders.intake}"
                  "eventSubType" = "copy"
                  "name" = "Copy the CLM workspace template into the intake folder"
                  "order" = 1
                  "outputs" = [
                    "folderId"
                  ]
                  "sourceFolderId" = "<workspaceTemplateFolderId>"
                  "type" = "Folder Action"
                }
                {
                  "eventSubType" = "rename"
                  "folderId" = {
                    "type" = "variable"
                    "value" = "static.outcome_<step1>.folderId"
                  }
                  "name" = "Name the workspace from the workflow year and Contract ID"
                  "newName" = {
                    "note" = "Stored in the editor as one interpolated string. Each token appears wrapped in a dollar sign and braces."
                    "template" = "CLM-{year}-{contractId}"
                    "tokens" = {
                      "contractId" = "static.trigger.metadata.contractId"
                      "year" = "static.workflow.createdAt__YYYY__"
                    }
                  }
                  "order" = 2
                  "type" = "Folder Action"
                }
                {
                  "agentId" = "default_box_agent"
                  "agentName" = "Box Agent"
                  "agentRef" = "config/box/ai-agent-specs.bcl#contract-risk-triage"
                  "contextItems" = [
                    {
                      "type" = "variable"
                      "value" = "static.trigger.fileId"
                    }
                  ]
                  "eventSubType" = "default"
                  "expectedOutput" = [
                    "riskLevel"
                    "materialDeviations"
                    "requiredReviewers"
                    "evidenceItemIds"
                  ]
                  "instructions" = {
                    "note" = "In the live draft the clause-library folder ID is typed as a literal rather than bound, which is the portability defect recorded in openIssues."
                    "template" = "Review Box file ID {fileIds} against the approved clause library in folder ID {clauseLibraryFolderId}. Produce a concise approval brief covering risk, clause deviations, responsible reviewers, and recommended standard or approved fallback. Treat Extract output as draft and require human validation."
                    "tokens" = {
                      "clauseLibraryFolderId" = "${box.folders.clauses}"
                      "fileIds" = "static.trigger.fileId"
                    }
                  }
                  "name" = "CLM Contract Risk Triage"
                  "order" = 3
                  "outputFormat" = "textValue"
                  "type" = "Box Agent"
                }
                {
                  "assignees" = [
                    "${box.reviewers.primary}"
                  ]
                  "dueDate" = null
                  "eventSubType" = "approval"
                  "fileId" = {
                    "type" = "variable"
                    "value" = "static.trigger.fileId"
                  }
                  "inviteAssigneesAsViewers" = true
                  "managers" = [
                    {
                      "type" = "variable"
                      "value" = "static.workflow.ownerId"
                    }
                  ]
                  "message" = "Validate Extract values and the Box Agent approval brief. Confirm clause position, risk level, and reviewer routing before any downstream connector runs."
                  "name" = "Validate extracted terms and approval brief"
                  "order" = 4
                  "outcomes" = [
                    "Approved"
                    "Rejected"
                  ]
                  "requireOnlyOneAssigneeToComplete" = false
                  "required" = true
                  "riskLevelGate" = "The reviewer sets or confirms the risk level here. Apply the validated value to the clmContract metadata so the connector binds Risk_Level__c from validated metadata, never from raw Box Agent text."
                  "type" = "Approval Task"
                }
                {
                  "branches" = [
                    {
                      "condition" = {
                        "leftOperand" = "static.outcome_<step4>.taskStatus"
                        "logicalConnector" = "EQUALS"
                        "rightOperand" = "APPROVED"
                        "type" = "task"
                      }
                      "label" = "Approved"
                      "next" = [
                        "salesforceContractCreate"
                      ]
                    }
                    {
                      "behavior" = "Returns the contract for correction; makes no Salesforce call."
                      "condition" = {
                        "leftOperand" = "static.outcome_<step4>.taskStatus"
                        "logicalConnector" = "EQUALS"
                        "rightOperand" = "REJECTED"
                        "type" = "task"
                      }
                      "label" = "Rejected"
                      "next" = [
                        "returnForCorrection"
                      ]
                    }
                  ]
                  "gatewaySubtype" = "exclusive"
                  "gatewayType" = "split"
                  "order" = 5
                  "type" = "Conditional Split"
                }
                {
                  "authType" = "OAUTH2_CLIENT_CREDENTIALS_GRANT"
                  "bodyBinding" = "metadata-trigger variables, see config/box/https-connectors.bcl#salesforceContractCreate.bodyImplementation"
                  "branch" = "Approved"
                  "connectorId" = "<salesforceConnectorId>"
                  "connectorName" = "the Salesforce connector whose base URL is the org holding CLM_Contract__c"
                  "connectorRef" = "config/box/https-connectors.bcl#salesforce-clm-rest"
                  "credentialId" = "<salesforceCredentialId>"
                  "duplicateStrategy" = "This POST is not idempotent: a re-trigger on the same Contract_ID__c creates a second record. For dedup, switch to the external-ID PATCH upsert (salesforceContractUpsert) plus the lookup in config/box/https-connectors.bcl, or gate on an existing-record check before calling."
                  "endpoint" = "services/data/v67.0/sobjects/CLM_Contract__c"
                  "endpointNote" = "Stored without a leading slash. The connector switch normalised this to match the reference outcome."
                  "eventSubType" = "call"
                  "liveState" = "The form-triggered variant of this POST was proven end to end on 2026-07-22: a Form submission created a real CLM_Contract__c record with all mapped fields verified on the Salesforce record. This packaged design replaces the Form trigger with a clmContract metadata trigger and re-sources every dynamic value from static.trigger.metadata.<field>. That metadata-triggered variant has not been re-verified live and must be re-tested before activation."
                  "method" = "POST"
                  "operation" = "salesforceContractCreate"
                  "order" = 6
                  "outputVariables" = {
                    "recordId" = {
                      "jsonPath" = "$.id"
                      "key" = "recordId"
                      "note" = "Created CLM_Contract__c record id; retained for downstream steps or a lookup."
                    }
                  }
                  "type" = "HTTPS Request"
                }
                {
                  "assignees" = [
                    "${box.reviewers.primary}"
                  ]
                  "branch" = "Rejected"
                  "fileId" = {
                    "type" = "variable"
                    "value" = "static.trigger.fileId"
                  }
                  "key" = "returnForCorrection"
                  "message" = "Correct the flagged terms or metadata, then re-apply the clmContract metadata to re-enter intake. No Salesforce record was created."
                  "name" = "Return the contract for correction"
                  "order" = 7
                  "type" = "Create Task"
                }
              ]
              "testGate" = {
                "firstTrigger" = "Creates one Salesforce record and captures its recordId"
                "rejectedValidation" = "Makes no Salesforce request; creates a return-for-correction task"
                "repeatTrigger" = "Creates a second record (POST is not idempotent); restore the external-ID upsert if dedup is required"
              }
              "trigger" = {
                "condition" = "clmContract metadata applied on a file with the Salesforce-required fields (contractId, contractType, counterparty, requesterEmail) populated"
                "folderId" = "${box.folders.intake}"
                "templateKey" = "clmContract"
                "type" = "Metadata updated"
              }
              "variableSyntax" = {
                "freeTextField" = "Interpolates the token wrapped in a dollar sign and braces."
                "metadataField" = "static.trigger.metadata.<key>"
                "note" = "Metadata-trigger tokens. A metadata trigger yields the triggering file as static.trigger.fileId and each template value as static.trigger.metadata.<key>. The former form-trigger tokens were removed with the Form; these bindings replace them but have not been re-verified against a live metadata-triggered graph."
                "priorOutcomeProperty" = "static.outcome_<outcomeId>.<property>"
                "structuredField" = "Stores {\"type\":\"variable\",\"value\":\"<token>\"}."
                "triggerFileId" = "static.trigger.fileId"
                "workflowCreatedYear" = "static.workflow.createdAt__YYYY__"
                "workflowProperty" = "static.workflow.<property>"
              }
              "verification" = {
                "everPublished" = false
                "liveStatus" = "DRAFT"
                "method" = "Designed from the proven form-triggered live draft, then converted to a clmContract metadata trigger."
                "note" = "The form-triggered variant was verified against the live draft on 2026-07-22 and proven end to end. This metadata-triggered variant is a redesign that has NOT been rebuilt or re-verified live. Trigger, file, and metadata bindings must be confirmed against a live metadata-triggered graph before activation. Environment-specific workflow, folder, connector, credential, and user IDs are bound at provisioning time and are deliberately not stored here."
                "supersedesFormTrigger" = "2026-07-22 form-triggered live draft"
              }
            }
            {
              "initialStatus" = "inactive"
              "key" = "redline-domain-review-routing"
              "name" = "CLM - Redline Domain Review Routing"
              "required" = false
              "steps" = [
                {
                  "agentRef" = "config/box/ai-agent-specs.bcl#redline-difference-router"
                  "order" = 1
                  "type" = "Box Agent"
                }
                {
                  "condition" = "Unclassified or confidence below 0.85 routes to Legal Operations triage"
                  "order" = 2
                  "type" = "Conditional Split"
                }
                {
                  "operation" = "routeRedlineFindings"
                  "order" = 3
                  "status" = "requires custom Apex implementation"
                  "type" = "HTTPS Request"
                }
                {
                  "order" = 4
                  "templateKey" = "clmRedlineReview"
                  "type" = "Apply Metadata"
                }
                {
                  "assignee" = "${box.reviewers.primary}"
                  "order" = 5
                  "type" = "Create Task"
                  "when" = "Needs Triage"
                }
              ]
              "trigger" = {
                "condition" = "versionStatus equals Redline"
                "folderId" = "${box.folders.drafts}"
                "templateKey" = "clmDocument"
                "type" = "Metadata updated"
              }
            }
            {
              "initialStatus" = "inactive"
              "key" = "approval-packet-readiness"
              "name" = "CLM - Approval Packet Readiness"
              "required" = false
              "steps" = [
                {
                  "agentRef" = "config/box/ai-agent-specs.bcl#approval-brief"
                  "order" = 1
                  "type" = "Box Agent"
                }
                {
                  "order" = 2
                  "purpose" = "Approve Doc Gen creation"
                  "type" = "Human Confirmation"
                }
                {
                  "destinationFolderId" = "${box.folders.approvals}"
                  "order" = 3
                  "templateFileId" = "${box.files.docgenApprovalMemo}"
                  "type" = "Generate Document"
                }
              ]
              "trigger" = "All required human review tasks completed"
            }
            {
              "initialStatus" = "inactive"
              "key" = "executed-agreement-obligations"
              "name" = "CLM - Executed Agreement Obligations"
              "required" = false
              "steps" = [
                {
                  "configurationRef" = "config/box/extract-field-prompts.bcl#executedObligations"
                  "order" = 1
                  "type" = "Extract Agent"
                }
                {
                  "agentRef" = "config/box/ai-agent-specs.bcl#obligation-review"
                  "order" = 2
                  "type" = "Box Agent"
                }
                {
                  "assignee" = "${box.reviewers.primary}"
                  "order" = 3
                  "type" = "Approval Task"
                }
                {
                  "destinationFolderId" = "${box.folders.obligations}"
                  "order" = 4
                  "templateKey" = "clmObligation"
                  "type" = "Apply Metadata"
                }
              ]
              "trigger" = {
                "folderId" = "${box.folders.executed}"
                "type" = "File uploaded"
              }
            }
          ]
        }
        "metadata" = {
          "artifactName" = "automate-workflows"
          "artifactType" = "config_file"
          "createdAt" = "2026-07-23T11:55:20Z"
          "enterpriseId" = ""
          "provider" = "generic"
          "providerObjectId" = "box/automate-workflows"
          "scenario" = "box-bedrock-for-clm"
        }
        "name" = "config_box_automate-workflows"
        "provider" = "generic"
        "scenario" = "box-bedrock-for-clm"
        "terraformType" = "null_resource"
        "type" = "config_file"
      }
    ]
    "scenario" = "box-bedrock-for-clm"
    "version" = "1.0"
  }
}
