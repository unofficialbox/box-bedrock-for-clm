            "Place a human validation or approval task after every generative or extractive AI result."
            "Send only allowlisted structured fields through HTTPS connectors; never send contract bytes or secrets."
            "Keep workflows inactive until trigger, permissions, OAuth, idempotency, and rollback tests pass."
          ]
          "enterprise_id" = ""
          "provider" = "generic"
          "provider_object_id" = "box/automate-workflows"
          "schemaVersion" = "2.0"
          "workflows" = [
            {
              "description" = "Extract request terms, run the CLM intake agent, route human validation, and emit an approved integration event."
