                      "Intake_Workflow_Run_ID__c" = "No workflow-run identifier confirmed among available variables."
                      "Last_Box_Sync__c" = "No current-timestamp variable confirmed."
                      "Risk_Level__c" = "The Box Agent emits unstructured text, not a picklist value. Restore once a structured Extract or Agent output supplies it."
                      "Status__c" = "Present only in the metadata-trigger test outcome."
                    }
                    "note" = "Deliberately absent. Each is sourced from an optional Form field, so binding it risks sending 'Variable unavailable' into a typed Salesforce field."
                    "textAndOptional" = {
