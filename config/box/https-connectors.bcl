                  "blankSafety" = "Only contractId, dealValue, and targetSignatureDate are bound dynamically. They supply Salesforce's three required demo fields: Name, Amount, and Target Signature Date. Optional metadata is deliberately omitted because Box substitutes the literal string 'Variable unavailable' for an unresolved value."
                  "body" = {
                    "Contract_ID__c" = {
                      "bind" = "metadata.contractId"
                      "integrationKey" = true
                    }
                    "Deal_Value__c" = {
                      "bind" = "metadata.dealValue"
