                      "note" = "Two similarly named connectors in this environment point at different orgs. Posting a valid payload to the org without the object fails with an opaque UNKNOWN_ERROR."
                      "wrongOrgConnectorHost" = "kadams-dev-ed.develop.my.salesforce.com"
