              "baseUrl" = "${salesforce.myDomainUrl}"
              "initialStatus" = "unconfigured"
              "key" = "salesforce-clm-rest"
              "name" = "Salesforce CLM REST API"
              "operations" = {
                "routeRedlineFindings" = {
                  "endpoint" = "/services/apexrest/clm/redline-routing"
                  "method" = "POST"
                  "requiredFor" = "Cross-Platform Agentic Orchestration live redline routing"
                  "status" = "not implemented"
                }
                "salesforceContractCreate" = {
                  "authType" = "OAUTH2_CLIENT_CREDENTIALS_GRANT"
                  "blankSafety" = "The clmContract metadata sources must be populated before the trigger fires. Box substitutes the literal string 'Variable unavailable' for an unresolved metadata variable, so an unpopulated field corrupts a typed Salesforce field rather than arriving blank."
                  "body" = {
                    "Contract_ID__c" = {
                      "bind" = "metadata.contractId"
                      "salesforceRequired" = true
                    }
                    "Contract_Type__c" = {
                      "bind" = "metadata.contractType"
                      "note" = "Restricted picklist. Must come from a populated clmContract metadata field."
                      "salesforceRequired" = true
                    }
                    "Counterparty__c" = {
                      "bind" = "salesforceRecord.counterparty"
                      "salesforceRequired" = true
                    }
                    "Counterparty_Account__c" = {
                      "bind" = "salesforceRecord.counterpartyAccount"
                      "note" = "Lookup to Account. The metadata field holds the Account NAME; resolve it to an Account Id before binding. Posting the name into the Lookup fails."
                      "requiresIdResolution" = "Account.Name -> Account.Id"
                      "salesforceRequired" = false
                    }
                    "Data_Category__c" = {
                      "bind" = "metadata.dataCategory"
                      "note" = "Restricted picklist. Inferred from the data-protection clause and the Exhibit A data-categories paragraph; see config/box/extract-field-prompts.bcl. Inference over prose is weaker than a copied label, so validate at the approval task before this binds."
                      "salesforceRequired" = false
                    }
                    "Deal_Value__c" = {
                      "bind" = "metadata.dealValue"
                      "note" = "Currency. Caused the 2026-07-22 live failure when sourced from an optional Form field. Now extracted from the fee clause and the Exhibit A fees paragraph, which state the amount in words and figures ('Two Hundred Fifty Thousand Dollars ($250,000.00)'). Extract must return the bare number; validate at the approval task before this binds."
                      "salesforceRequired" = false
                    }
                    "Name" = {
                      "bind" = "salesforceRecord.counterparty"
                      "literalPrefix" = "CLM Intake - "
                    }
                    "Opportunity__c" = {
                      "bind" = "salesforceRecord.opportunity"
                      "note" = "Lookup to Opportunity. The metadata field holds the Opportunity NAME; resolve it to an Opportunity Id before binding. Posting the name into the Lookup fails."
                      "requiresIdResolution" = "Opportunity.Name -> Opportunity.Id"
                      "salesforceRequired" = false
                    }
                    "Record_Source__c" = "Box Automate"
                    "Region__c" = {
                      "bind" = "metadata.region"
                      "note" = "Restricted picklist. Inferred from the territory and place-of-performance language, which names countries rather than region codes, so Extract must map United States to US. Validate at the approval task before this binds."
                      "salesforceRequired" = false
                    }
                    "Requester_Email__c" = {
                      "bind" = "metadata.requesterEmail"
                      "salesforceRequired" = true
                    }
                    "Requester_Name__c" = {
                      "bind" = "metadata.requesterName"
                      "salesforceRequired" = false
                    }
                    "Risk_Level__c" = {
                      "bind" = "metadata.riskLevel"
                      "humanValidated" = true
                      "note" = "Restricted picklist. Bound only from clmContract metadata that the reviewer set or confirmed at the approval task (order 4, riskLevelGate). Never bind raw Box Agent text."
                      "salesforceRequired" = false
                    }
                    "Special_Terms_Risk_Notes__c" = {
                      "bind" = "metadata.specialTermsRiskNotes"
                      "humanValidated" = true
                      "note" = "Text. Not a contract term and not extracted from the document. The reviewer writes it at the approval task alongside the risk level. Text tolerates the 'Variable unavailable' substitution without rejecting the request, so it fails visibly rather than breaking the POST."
                      "salesforceRequired" = false
                    }
                    "Term_Months__c" = {
                      "bind" = "metadata.termMonths"
                      "note" = "Number. Caused the 2026-07-22 live failure when sourced from an optional Form field. Now extracted from the initial-term clause and the Exhibit A term paragraph, which state the figure in words and digits ('thirty-six (36) months')."
                      "salesforceRequired" = false
                    }
                  }
                  "bodyEncoding" = {
                    "blankSafetySupersedes" = "An earlier note in this file claimed an unresolved value yields an empty string and that quoting numeric fields made the body blank-safe. The live run disproved both. Quoting keeps the JSON syntactically valid but does not stop Salesforce rejecting the value."
                    "fieldGuidPortability" = "The metadata field GUID is enterprise-specific and must be resolved from the target template at provisioning time. It is not portable."
                    "note" = "Box Automate stores an HTTPS body as an ordered CONCAT of operands. Literal JSON segments are VALUE operands; each dynamic value is its own operand spliced between them. Merge tokens are not brace-delimited text inside the stored body."
                    "operandTypes" = {
                      "DATE_FORMAT" = "Renders one component of a date or datetime variable. The editor offers a full ISO string or single components; there is no YYYY-MM-DD preset, so a date-only value is built from three DATE_FORMAT operands joined by literal hyphens."
                      "DYNAMIC_VARIABLE" = "Trigger-derived property, addressed by ref, for example ref trigger.fileParentFolderName."
                      "GET_FILE_METADATA_FIELD" = "Reads one metadata field. Operands in order: VARIABLE(file path), VALUE(templateKey, METADATA_TEMPLATE_KEY), VALUE(fieldGuid, STRING), VALUE(scope, METADATA_TEMPLATE_SCOPE)."
                      "VALUE" = "Literal string segment. dataType STRING."
                      "VARIABLE" = "Graph variable addressed by path, for example path trigger.metadata.<key>."
                      "secondTemplateNote" = "A metadata trigger exposes only the triggering template as trigger.metadata.<key>. Binds written as salesforceRecord.<key> in this body come from a second template on the same file and must be read with GET_FILE_METADATA_FIELD operands (file path, templateKey salesforceRecord, fieldGuid, scope), not as trigger.metadata paths."
                    }
                    "storedAs" = "CONCAT operand list, not a single string"
                    "unresolvedVariableBehaviour" = "Observed in a live run on 2026-07-22. Box Automate substitutes the literal string 'Variable unavailable' for a variable that does not resolve. It does not substitute an empty string or a null. Any Salesforce field that cannot accept that text will reject the request, which covers every Number, Currency, Date, and restricted Picklist field. Only bind a value whose source is mandatory, or accept that the field may receive the phrase 'Variable unavailable'."
                  }
                  "bodyImplementation" = {
                    "designRule" = "Bind only values whose clmContract metadata field is guaranteed populated before the trigger fires. Box substitutes the literal 'Variable unavailable' for anything unresolved, so an unpopulated source can poison a typed Salesforce field."
                    "history" = "A 19-field version bound every Form field, including optional ones. It failed in a live run because Deal_Value__c (Currency) and Term_Months__c (Number) received 'Variable unavailable'. The Form was later removed entirely and every dynamic value re-sourced from clmContract metadata. On 2026-07-29 the previously omitted fields were restored once every one of them was stated on the face of the intake contract and given an extract prompt; see bodyOmissions.restoredOn2026-07-29."
                    "note" = "Re-sourced from the proven form-triggered body. Every dynamic value now addresses a clmContract metadata field as trigger.metadata.<key> instead of a Form field. This metadata-sourced body has NOT been re-verified against a live run; the CONCAT reconstruction below describes the proven form-triggered body it was derived from."
                    "trigger" = "metadata"
                    "verification" = "The form-triggered body was reconstructed from the persisted CONCAT operands (15 operands, 7 dynamic, 10 fields) and parsed as JSON, every dynamic value backed by a required Form field. The metadata re-source preserves the same fields but must be re-verified live before activation."
                  }
                  "bodyOmissions" = {
                    "howToRestore" = "Populate the source metadata field before the trigger fires, then bind it. That is the only way to guarantee it resolves."
                    "neverBound" = {
                      "Status__c" = "Present only in the metadata-trigger test outcome."
                    }
                    "note" = "Deliberately absent. Each is sourced from a metadata field that is not guaranteed populated, so binding it risks sending 'Variable unavailable' into a typed Salesforce field."
                    "restoredOn2026-07-29" = {
                      "fieldsRestored" = [
                        "Counterparty_Account__c"
                        "Data_Category__c"
                        "Deal_Value__c"
                        "Opportunity__c"
                        "Region__c"
                        "Requester_Name__c"
                        "Risk_Level__c"
                        "Special_Terms_Risk_Notes__c"
                        "Term_Months__c"
                      ]
                      "humanSourcedNotExtracted" = [
                        "Risk_Level__c"
                        "Special_Terms_Risk_Notes__c"
                      ]
                      "lookupCaveat" = "Counterparty_Account__c and Opportunity__c are Lookups. Their metadata fields hold display NAMES, so the workflow must resolve each name to a Salesforce Id before binding. Binding the raw name fails regardless of whether the variable resolves."
                      "reason" = "These were previously omitted because their sources were optional Form or metadata fields that nothing populated. Every one of them is now stated on the face of the intake contract in ordinary contract language - the parties clause, the fee clause, the term clause, the data-protection clause, the notices clause, and the Exhibit A order form - and config/box/extract-field-prompts.bcl carries a prompt for each. Risk_Level__c and Special_Terms_Risk_Notes__c are the exceptions: they are assessments rather than contract terms and come from the human reviewer at the approval task."
                      "residualRisk" = "Weaker than a copied label. These values are extracted by inference over legal prose, not read from a labelled field, so the source is populated but the extraction can still be wrong: a contract stating amounts in words and figures, naming countries instead of region codes, or excluding PHI only by negative covenant can all yield a wrong-but-well-formed value. A wrong value passes the typed-field check and lands silently on the Salesforce record. The human approval task (order 4) is therefore load-bearing for Deal_Value__c, Term_Months__c, Region__c, and Data_Category__c, not merely advisory. A contract that omits any of these terms leaves the field blank and reintroduces the 2026-07-22 'Variable unavailable' failure on the Currency, Number, and picklist columns."
                      "riskLevelCondition" = "Risk_Level__c is bound from validated metadata only. The reviewer sets or confirms it at the approval task (order 4) before the connector runs; raw Box Agent text is still never bound."
                      "verified" = false
                      "verifiedNote" = "Not re-verified against a live run. The 2026-07-22 proof covers only the ten-field form-triggered body. Re-test end to end before activation."
                    }
                    "typeSensitiveAndOptional" = {
                      "Business_Owner_Name__c" = "Text. Printed on the contract but not yet extracted into metadata; add an extract prompt before binding."
                      "Target_Signature_Date__c" = "Date, composed from three DATE_FORMAT operands. Not printed on the contract, so it would fail whenever the metadata date is blank."
                    }
                  }
