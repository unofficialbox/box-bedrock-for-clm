{
  "schemaVersion": "2.0",
  "connectors": [
    {
      "key": "salesforce-clm-rest",
      "name": "Salesforce CLM REST API",
      "initialStatus": "unconfigured",
      "baseUrl": "${salesforce.myDomainUrl}",
      "apiVersion": "67.0",
      "authentication": {
        "type": "OAuth 2.0 client credentials",
        "tokenUrl": "${salesforce.myDomainUrl}/services/oauth2/token",
        "scope": "api",
        "runAsUser": "${salesforce.integrationUsername}",
        "secretStorage": "Box-managed connection only"
      },
      "operations": {
        "salesforceContractUpsert": {
          "method": "PATCH",
          "endpoint": "/services/data/v67.0/sobjects/CLM_Contract__c/Contract_ID__c/{urlEncodedContractId}",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "Name": "<counterparty> <contractType>",
            "Requester_Name__c": "requesterName",
            "Requester_Email__c": "requesterEmail",
            "Counterparty__c": "counterparty",
            "Contract_Type__c": "contractType",
            "Deal_Value__c": "dealValue",
            "Term_Months__c": "termMonths",
            "Region__c": "region",
            "Data_Category__c": "dataCategory",
            "Target_Signature_Date__c": "targetSignatureDate",
            "Business_Owner_Name__c": "businessOwner",
            "Risk_Level__c": "riskLevel",
            "Special_Terms_Risk_Notes__c": "specialTermsRiskNotes",
            "Box_Workspace_Folder_ID__c": "${box.folders.workspace}",
            "Box_Workspace_URL__c": "https://${box.hostname}/folder/${box.folders.workspace}",
            "Box_Intake_File_ID__c": "submittedFileId",
            "Box_Redline_File_ID__c": "submittedFileId",
            "Intake_Workflow_Run_ID__c": "workflowRunId",
            "Record_Source__c": "Box Form",
            "Latest_Routing_Status__c": "Not Started",
            "Open_Review_Task_Count__c": 0,
            "Last_Box_Sync__c": "currentTimestamp"
          },
          "expectedStatus": [200, 201, 204],
          "idempotencyKey": "contractId"
        },
        "salesforceContractLookup": {
          "method": "GET",
          "endpoint": "/services/data/v67.0/sobjects/CLM_Contract__c/Contract_ID__c/{urlEncodedContractId}?fields=Id,Contract_ID__c,Box_Workspace_Folder_ID__c",
          "expectedStatus": [200],
          "outputVariables": {
            "recordId": "$.Id",
            "contractId": "$.Contract_ID__c",
            "boxFolderId": "$.Box_Workspace_Folder_ID__c"
          }
        },
        "routeRedlineFindings": {
          "method": "POST",
          "endpoint": "/services/apexrest/clm/redline-routing",
          "status": "not implemented",
          "requiredFor": "Cross-Platform Agentic Orchestration live redline routing"
        }
      },
      "prohibitedPayload": ["contract bytes", "Box access tokens", "connector secrets", "signer credentials", "unreviewed AI output"]
    }
  ]
}
