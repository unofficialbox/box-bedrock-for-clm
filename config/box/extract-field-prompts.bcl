          "providerObjectId" = "box/extract-field-prompts"
          "scenario" = "box-bedrock-for-clm"
        }
        "name" = "config_box_extract-field-prompts"
        "provider" = "generic"
        "scenario" = "box-bedrock-for-clm"
        "terraformType" = "null_resource"
        "type" = "config_file"
      }
    ]
    "scenario" = "box-bedrock-for-clm"
    "version" = "1.0"
  }
}
