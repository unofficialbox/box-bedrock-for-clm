# Box Dispatch BCL config artifact. BCL is the only supported import format.
locals {
  "bcl" = {
    "context" = "clm"
    "generatedAt" = "2026-07-23T11:55:20Z"
    "metadata" = {
    }
    "provider" = "generic"
    "resources" = [
      {
        "config" = {
          "artifact_name" = "extract-field-prompts"
          "artifact_type" = "config"
          "contractIntake" = {
            "fields" = [
              {
                "field" = "contractType"
                "prompt" = "Classify as MSA Package, DPA, SOW, Order Form, or Procurement Agreement."
              }
              {
                "field" = "riskLevel"
                "prompt" = "Classify the agreement risk as Low, Medium, High, or Critical using only express contract terms and the approved clause library."
              }
              {
                "field" = "keyIssues"
                "prompt" = "Return a concise list of material clause deviations with section references. Do not provide final legal approval."
              }
              {
                "field" = "contractId"
                "prompt" = "Return the agreement reference number printed under the title or recited in the Exhibit A preamble, for example the value following 'Agreement Reference No.'. Return it exactly as written and do not invent or reformat it."
              }
              {
                "field" = "counterparty"
                "prompt" = "Return the legal name of the customer party only, as introduced in the opening paragraph. The customer is the party defined as 'Customer'; the other party is the supplier and must not be returned. Return the entity name without its quoted short-form defined term, jurisdiction, or entity-type description."
              }
              {
                "field" = "counterpartyAccount"
                "prompt" = "Return the same customer legal name as the counterparty field. This value is matched against a Salesforce Account by name, so return the entity name alone with no address, defined term, or entity-type wording."
              }
              {
                "field" = "opportunity"
                "prompt" = "Return the named procurement programme or initiative the order form is issued in connection with, as recited in the Exhibit A preamble. Return the programme name only. If no programme is named, return null rather than guessing."
              }
              {
                "field" = "requesterName"
                "prompt" = "Return the personal name of the customer's contract or procurement contact from the notices clause or the Exhibit A customer-contacts paragraph. Return the person's name only, without title, company, or email. Do not return the supplier's contact or a generic team mailbox."
              }
              {
                "field" = "requesterEmail"
                "prompt" = "Return the email address of the customer's contract or procurement contact from the notices clause or the Exhibit A customer-contacts paragraph. Return the bare address with no display name or 'Email:' prefix. Do not return the supplier's address. Salesforce marks this field required, so it must never be blank; if no customer contact address appears, fail the extraction rather than returning a supplier address."
              }
              {
                "field" = "dealValue"
                "prompt" = "Return the total fees payable for the initial term as a bare decimal number. Contracts state amounts in words followed by figures, for example 'Two Hundred Fifty Thousand Dollars ($250,000.00)'; return only the numeric amount with no currency symbol, no grouping separators, no words, and no trailing text. Use the total for the initial term, not an annual or monthly figure. Salesforce Deal_Value__c is a Currency field and rejects any other text."
              }
              {
                "field" = "termMonths"
                "prompt" = "Return the length of the initial term in whole months as a bare integer. Contracts state this in words followed by figures, for example 'thirty-six (36) months'; return only the integer. Use the initial term, not a renewal period or a notice period. Salesforce Term_Months__c is a Number field and rejects any other text."
              }
              {
                "field" = "region"
                "prompt" = "Return exactly one of US, EU, APAC, or Global. Infer it from the territory or place-of-performance language, for example an Exhibit A territory paragraph limiting the services to the United States yields US. Map named countries to their region rather than returning the country name. If the contract names territories across more than one region, return Global. Salesforce Region__c is a restricted picklist and rejects any other value."
              }
              {
                "field" = "dataCategory"
                "prompt" = "Return exactly one of None, Personal Data, PHI, Financial Data, or Confidential, based on the data-protection clause and any Exhibit A data-categories paragraph. Language expressly confirming that no protected health information or special category of personal data is processed yields None. Return PHI only where the contract affirmatively contemplates health information in scope, not where it excludes it or merely mentions a future business associate agreement. Salesforce Data_Category__c is a restricted picklist and rejects any other value."
              }
            ]
            "extractionSource" = "The contract text itself. northstar-msa-2026-redline.docx, generated by scripts/generate_docgen_templates.py, is a genuine MSA draft: the values below appear in the parties clause, the fee clause, the term clause, the data-protection clause, the notices clause, and the Exhibit A order form, stated as a contract states them. There is no labelled summary block to copy from, so each prompt has to normalise real legal prose ('Two Hundred Fifty Thousand Dollars ($250,000.00)' to 250000.00, 'thirty-six (36) months' to 36, a United States territory clause to US)."
            "purpose" = "Create a reviewable contract record from an intake package."
            "redlineNote" = "The intake document is in redline: some clauses carry struck-through supplier language beside inserted counterparty language. Where a clause has been marked up, extract the value the settled text supports and leave contested economics to the human reviewer. None of the fields above sit inside a redlined span in the current fixture; payment terms, service credits, breach notice, the liability cap, termination for convenience, and governing law are the contested clauses, and none of them map to a bound Salesforce field."
            "typedFieldNote" = "Box Automate substitutes the literal string 'Variable unavailable' for an unresolved variable, so a blank extraction corrupts a typed Salesforce field rather than arriving empty. dealValue, termMonths, region, and dataCategory feed Currency, Number, and restricted-picklist columns; validate each at the human approval task before the connector runs. See config/box/https-connectors.bcl#bodyEncoding.unresolvedVariableBehaviour."
          }
          "created_at" = "2026-07-23T11:55:20Z"
          "enterprise_id" = ""
          "executedObligations" = {
            "fields" = [
              {
                "field" = "obligationType"
                "prompt" = "Classify as Renewal Notice, SLA Report, Security Evidence, Data Deletion, Insurance, or Billing."
              }
              {
                "field" = "owner"
                "prompt" = "Return the named responsible party or team. If not explicit, return Unassigned."
              }
              {
                "field" = "dueDate"
                "prompt" = "Return the explicit due date in YYYY-MM-DD format. If only a relative period exists, quote the period and return null."
              }
              {
                "field" = "sourceClause"
                "prompt" = "Quote only the clause heading and section number; do not reproduce the full clause."
              }
              {
                "field" = "reminderWindowDays"
                "prompt" = "Return the explicit notice or reminder window in days. Otherwise return null."
              }
            ]
            "purpose" = "Extract explicit post-signature duties for human validation."
          }
          "provider" = "generic"
          "provider_object_id" = "box/extract-field-prompts"
        }
        "metadata" = {
          "artifactName" = "extract-field-prompts"
          "artifactType" = "config_file"
          "createdAt" = "2026-07-23T11:55:20Z"
          "enterpriseId" = ""
