{
  "schemaVersion": "2.0",
  "bindingModel": "Resolve with python3 scripts/demo_operator.py resolve-config",
  "designPrinciples": [
    "Use resolved Box content IDs rather than display names in workflow bindings.",
    "Place a human validation or approval task after every generative or extractive AI result.",
    "Send only allowlisted structured fields through HTTPS connectors; never send contract bytes or secrets.",
    "Keep workflows inactive until trigger, permissions, OAuth, idempotency, and rollback tests pass."
  ],
  "workflows": [
    {
      "key": "contract-intake-enrichment",
      "name": "CLM - Contract Intake Enrichment",
      "required": true,
      "initialStatus": "inactive",
      "trigger": {
        "type": "Box Forms submission",
        "formName": "New Contract Request",
        "formUrl": "${box.formUrl}",
        "destinationFolderId": "${box.folders.intake}"
      },
      "requiredFormVariables": [
        "requesterName", "requesterEmail", "contractId", "counterparty", "contractType",
        "dealValue", "termMonths", "region", "dataCategory", "targetSignatureDate",
        "businessOwner", "submittedFileId", "specialTermsRiskNotes"
      ],
      "steps": [
        {
          "order": 1,
          "type": "Extract Agent",
          "name": "Contract Intake Extract",
          "source": "submitted file",
          "configurationRef": "config/box/extract-field-prompts.json#contractIntake",
          "expectedOutput": ["contractType", "riskLevel", "keyIssues"]
        },
        {
          "order": 2,
          "type": "Box Agent",
          "name": "CLM Contract Risk Triage",
          "agentRef": "config/box/ai-agent-specs.json#contract-risk-triage",
          "expectedOutput": ["riskLevel", "materialDeviations", "requiredReviewers", "evidenceItemIds"]
        },
        {
          "order": 3,
          "type": "Approval Task",
          "name": "Validate extracted terms and approval brief",
          "assignee": "${box.reviewers.primary}",
          "required": true,
          "outcomes": ["Approved", "Rejected"]
        },
        {
          "order": 4,
          "type": "Conditional Split",
          "condition": "approval task outcome",
          "approvedBranch": ["salesforceContractUpsert", "salesforceContractLookup"],
          "rejectedBranch": "Stop and return the request for correction"
        },
        {
          "order": 5,
          "type": "HTTPS Request",
          "operation": "salesforceContractUpsert",
          "connectorRef": "config/box/https-connectors.json#salesforce-clm-rest"
        },
        {
          "order": 6,
          "type": "HTTPS Request",
          "operation": "salesforceContractLookup",
          "connectorRef": "config/box/https-connectors.json#salesforce-clm-rest",
          "outputVariables": {
            "recordId": "$.Id",
            "contractId": "$.Contract_ID__c",
            "boxFolderId": "$.Box_Workspace_Folder_ID__c"
          }
        }
      ],
      "testGate": {
        "firstSubmission": "Creates one Salesforce record",
        "duplicateSubmission": "Updates the same record",
        "rejectedSubmission": "Makes no Salesforce request"
      }
    },
    {
      "key": "redline-domain-review-routing",
      "name": "CLM - Redline Domain Review Routing",
      "required": false,
      "initialStatus": "inactive",
      "trigger": {
        "type": "Metadata updated",
        "folderId": "${box.folders.drafts}",
        "templateKey": "clmDocument",
        "condition": "versionStatus equals Redline"
      },
      "steps": [
        {"order": 1, "type": "Box Agent", "agentRef": "config/box/ai-agent-specs.json#redline-difference-router"},
        {"order": 2, "type": "Conditional Split", "condition": "Unclassified or confidence below 0.85 routes to Legal Operations triage"},
        {"order": 3, "type": "HTTPS Request", "operation": "routeRedlineFindings", "status": "requires custom Apex implementation"},
        {"order": 4, "type": "Apply Metadata", "templateKey": "clmRedlineReview"},
        {"order": 5, "type": "Create Task", "assignee": "${box.reviewers.primary}", "when": "Needs Triage"}
      ]
    },
    {
      "key": "approval-packet-readiness",
      "name": "CLM - Approval Packet Readiness",
      "required": false,
      "initialStatus": "inactive",
      "trigger": "All required human review tasks completed",
      "steps": [
        {"order": 1, "type": "Box Agent", "agentRef": "config/box/ai-agent-specs.json#approval-brief"},
        {"order": 2, "type": "Human Confirmation", "purpose": "Approve Doc Gen creation"},
        {"order": 3, "type": "Generate Document", "templateFileId": "${box.files.docgenApprovalMemo}", "destinationFolderId": "${box.folders.approvals}"}
      ]
    },
    {
      "key": "executed-agreement-obligations",
      "name": "CLM - Executed Agreement Obligations",
      "required": false,
      "initialStatus": "inactive",
      "trigger": {"type": "File uploaded", "folderId": "${box.folders.executed}"},
      "steps": [
        {"order": 1, "type": "Extract Agent", "configurationRef": "config/box/extract-field-prompts.json#executedObligations"},
        {"order": 2, "type": "Box Agent", "agentRef": "config/box/ai-agent-specs.json#obligation-review"},
        {"order": 3, "type": "Approval Task", "assignee": "${box.reviewers.primary}"},
        {"order": 4, "type": "Apply Metadata", "templateKey": "clmObligation", "destinationFolderId": "${box.folders.obligations}"}
      ]
    }
  ]
}
