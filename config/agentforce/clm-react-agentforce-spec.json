{
  "schemaVersion": "2.0",
  "name": "Contract Copilot",
  "context": {
    "contractId": "CLM-2026-0017",
    "salesforceObjectApiName": "CLM_Contract__c",
    "boxWorkspaceFolderId": "${box.folders.workspace}",
    "boxWorkspaceUrl": "https://${box.hostname}/folder/${box.folders.workspace}"
  },
  "topics": [
    {"name": "Contract package review", "actions": ["resolve_contract_context", "list_box_contract_files", "summarize_box_contract_package", "compare_redline_to_clause_playbook", "get_redline_review_queue"]},
    {"name": "Approval readiness", "actions": ["get_box_review_tasks", "explain_signature_blockers", "draft_box_docgen_approval_memo"]},
    {"name": "Post-signature obligations", "actions": ["extract_candidate_obligations", "draft_box_docgen_renewal_notice"]}
  ],
  "actions": {
    "resolve_contract_context": {"input": ["salesforceRecordId", "contractId", "boxFolderId"], "output": ["contract", "workspace", "status"], "mutates": false},
    "list_box_contract_files": {"input": ["boxFolderId"], "output": ["files", "metadata", "versions"], "mutates": false},
    "summarize_box_contract_package": {"input": ["boxFolderId"], "output": ["summary", "risks", "sourceCitations"], "mutates": false},
    "compare_redline_to_clause_playbook": {"input": ["redlineFileId", "baselineItemId", "clauseLibraryFolderId"], "output": ["redlineFindings", "fallbackOptions", "sourceCitations"], "outputSchema": "config/clm/redline-finding.schema.json", "mutates": false},
    "get_redline_review_queue": {"input": ["contractId"], "output": ["findingsByDomain", "expertAssignments", "unclassifiedFindings", "boxTasks"], "mutates": false},
    "get_box_review_tasks": {"input": ["contractId"], "output": ["legalTask", "financeTask", "privacySecurityTask"], "mutates": false},
    "explain_signature_blockers": {"input": ["contractId"], "output": ["blocked", "reasons", "requiredHumanDecisions"], "mutates": false},
    "draft_box_docgen_approval_memo": {"input": ["contractId", "templateFileId"], "templateFileId": "${box.files.docgenApprovalMemo}", "output": ["draftFileId", "sourceCitations"], "mutates": true, "confirmationRequired": true},
    "extract_candidate_obligations": {"input": ["executedAgreementFileId"], "output": ["candidateObligations", "sourceCitations"], "mutates": false},
    "draft_box_docgen_renewal_notice": {"input": ["contractId", "templateFileId"], "templateFileId": "${box.files.docgenRenewalNotice}", "output": ["draftFileId"], "mutates": true, "confirmationRequired": true}
  },
  "guardrails": [
    "Use Box as the source of truth for contract content and cite source files.",
    "Never copy contract bytes into Salesforce.",
    "Never approve legal language or complete a human review task.",
    "Resolve experts only from the maintained directory.",
    "Route unclassified or low-confidence findings to Legal Operations triage.",
    "Never create a Box Sign request until all required human approvals are complete.",
    "Require confirmation before Doc Gen creates a file."
  ]
}
