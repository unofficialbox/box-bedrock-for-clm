{
  "demo": "CLM-2026-Northstar",
  "orchestrator": {
    "name": "clm-supervisor-agent",
    "runtime": "AWS Bedrock AgentCore",
    "framework": "Strands",
    "routingMode": "supervisor",
    "finalizationPolicy": "signature_blocked_until_required_human_approvals_complete"
  },
  "agents": [
    {
      "name": "box-contract-package-agent",
      "layer": "unstructured-data",
      "systems": ["Box"],
      "responsibilities": ["read_contract_files", "apply_metadata", "create_tasks", "prepare_signature_packet"]
    },
    {
      "name": "clause-risk-agent",
      "layer": "unstructured-data",
      "systems": ["Box", "Clause Playbook"],
      "responsibilities": ["compare_to_playbook", "score_clause_risk", "cite_sources", "recommend_human_approvers"]
    },
    {
      "name": "salesforce-commercial-agent",
      "layer": "structured-data",
      "systems": ["Salesforce"],
      "responsibilities": ["compare_order_form_to_quote", "validate_account_status", "flag_finance_exceptions"]
    },
    {
      "name": "salesforce-approval-agent",
      "layer": "structured-data",
      "systems": ["Salesforce"],
      "responsibilities": ["route_approvals", "track_sla", "block_signature_until_complete"]
    },
    {
      "name": "databricks-analytics-agent",
      "layer": "analytics",
      "systems": ["Databricks"],
      "responsibilities": ["query_clause_outcomes", "benchmark_cycle_time", "enrich_risk_report"]
    },
    {
      "name": "obligation-monitor-agent",
      "layer": "follow-up",
      "systems": ["Box", "Salesforce", "Databricks"],
      "responsibilities": ["extract_obligations", "assign_owners", "create_renewal_and_notice_tasks"]
    }
  ],
  "guardrails": [
    "no_ai_final_legal_approval",
    "source_citation_required",
    "block_signature_until_required_approvals_complete",
    "privacy_security_approval_required_for_phi",
    "finance_approval_required_for_payment_term_mismatch"
  ],
  "sampleInputs": {
    "structuredRecord": "output/json/northstar-clm-records.json",
    "playbook": "output/json/clause-playbook.json",
    "analytics": "output/csv/historical-clause-outcomes.csv",
    "documents": "output/pdf/",
    "liveBoxSurface": "config/box/live-box-surface.json",
    "handoffPayloads": "config/agentcore/agent-handoff-payloads.json"
  },
  "localMock": {
    "script": "scripts/run_agentcore_mock.py",
    "output": "output/agentcore/northstar-agentcore-trace.json",
    "purpose": "Produces a deterministic supervisor trace for demo rehearsal before deploying AgentCore infrastructure."
  }
}
