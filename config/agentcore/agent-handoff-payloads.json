{
  "schemaVersion": "2.0",
  "demo": "CLM-2026-Northstar",
  "payloads": [
    {
      "from": "clm-supervisor-agent",
      "to": "box-contract-package-agent",
      "intent": "validate_package",
      "input": {
        "contractId": "CLM-2026-0017",
        "workspaceFolderId": "${box.folders.workspace}",
        "requiredDocumentTypes": ["MSA", "DPA", "SOW", "Order Form", "Security Exhibit", "Insurance"]
      },
      "expectedOutput": {
        "packageStatus": "complete",
        "fileIds": {
          "msa": "${box.files.msaRedline}",
          "dpa": "${box.files.dpa}",
          "sow": "${box.files.sow}",
          "orderForm": "${box.files.orderForm}",
          "securityExhibit": "${box.files.securityExhibit}",
          "insurance": "${box.files.insurance}"
        }
      }
    },
    {
      "from": "clm-supervisor-agent",
      "to": "salesforce-agentforce-commercial-specialist",
      "intent": "compare_order_form_to_record",
      "input": {"orderFormFileId": "${box.files.orderForm}", "structuredRecord": "output/json/northstar-clm-records.json"},
      "expectedOutput": {"field": "paymentTerms", "salesforceValue": "Net 45", "documentValue": "Net 90", "requiredApprover": "Finance"}
    },
    {
      "from": "clm-supervisor-agent",
      "to": "clause-risk-agent",
      "intent": "compare_to_playbook",
      "input": {
        "documentFileIds": ["${box.files.msaRedline}", "${box.files.dpa}", "${box.files.sow}", "${box.files.orderForm}"],
        "clauseLibraryFolderId": "${box.folders.clauses}"
      },
      "expectedOutput": {"minimumFindings": ["Unlimited liability", "PHI processing", "Uncapped SLA credits", "Net 90 payment terms"], "citationRequired": true}
    },
    {
      "from": "clause-risk-agent",
      "to": "databricks-analytics-agent",
      "intent": "enrich_clause_benchmarks",
      "input": {"analyticsSource": "output/csv/historical-clause-outcomes.csv"},
      "expectedOutput": {"metrics": ["standardAcceptedPct", "fallbackAcceptedPct", "avgNegotiationDays", "renewalImpact"]}
    },
    {
      "from": "clm-supervisor-agent",
      "to": "salesforce-agentforce-approval-specialist",
      "intent": "route_required_approvals",
      "input": {"contractId": "CLM-2026-0017", "riskLevel": "High", "dataCategory": "PHI", "dealValue": 2400000, "paymentTermsException": true},
      "expectedOutput": {"requiredApprovers": ["Finance", "Privacy", "Security", "Legal VP"]}
    }
  ]
}
