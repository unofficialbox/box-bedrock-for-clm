{
  "schemaVersion": "1.0",
  "objectApiName": "CLM_Contract__c",
  "label": "CLM Contract",
  "pluralLabel": "CLM Contracts",
  "nameField": {
    "apiName": "Name",
    "type": "Text",
    "value": "<counterparty> <contractType>"
  },
  "ownership": {
    "model": "Standard OwnerId",
    "defaultOwner": "Authenticated integration user",
    "businessOwnerField": "Business_Owner__c",
    "unresolvedBusinessOwnerField": "Business_Owner_Name__c",
    "sharingModel": "Private",
    "externalSharingModel": "Private"
  },
  "idempotency": {
    "field": "Contract_ID__c",
    "externalId": true,
    "unique": true,
    "operation": "upsert",
    "rule": "The Box workflow supplies contractId. Retries must return the existing record instead of creating a duplicate."
  },
  "boxReferences": {
    "workspaceFolderId": "Box_Workspace_Folder_ID__c",
    "workspaceUrl": "Box_Workspace_URL__c",
    "intakeFileId": "Box_Intake_File_ID__c",
    "redlineFileId": "Box_Redline_File_ID__c",
    "workflowRunId": "Intake_Workflow_Run_ID__c"
  },
  "intakeIntegration": {
    "type": "Salesforce standard REST API",
    "customApexRequired": false,
    "status": "specified-pending-org-configuration",
    "authentication": "OAuth 2.0 through a Box Automate managed HTTPS connection",
    "operations": [
      {
        "name": "salesforceContractUpsert",
        "method": "PATCH",
        "pathTemplate": "/services/data/{apiVersion}/sobjects/CLM_Contract__c/Contract_ID__c/{urlEncodedContractId}"
      },
      {
        "name": "salesforceContractLookup",
        "method": "GET",
        "pathTemplate": "/services/data/{apiVersion}/sobjects/CLM_Contract__c/Contract_ID__c/{urlEncodedContractId}?fields=Id,Contract_ID__c,Box_Workspace_Folder_ID__c"
      }
    ],
    "responseMapping": {
      "recordId": "Id",
      "contractId": "Contract_ID__c",
      "boxFolderId": "Box_Workspace_Folder_ID__c"
    }
  },
  "fieldMappings": [
    {"source": "contractId", "target": "Contract_ID__c", "required": true, "validation": "non-blank"},
    {"source": "requesterName", "target": "Requester_Name__c", "required": true},
    {"source": "requesterEmail", "target": "Requester_Email__c", "required": true},
    {"source": "counterparty", "target": "Counterparty__c", "required": true},
    {"source": "contractType", "target": "Contract_Type__c", "required": true},
    {"source": "dealValue", "target": "Deal_Value__c", "required": true},
    {"source": "termMonths", "target": "Term_Months__c", "required": false},
    {"source": "region", "target": "Region__c", "required": true},
    {"source": "dataCategory", "target": "Data_Category__c", "required": true},
    {"source": "targetSignatureDate", "target": "Target_Signature_Date__c", "required": true},
    {"source": "businessOwner", "target": "Business_Owner_Name__c", "required": true},
    {"source": "resolvedBusinessOwnerUserId", "target": "Business_Owner__c", "required": false, "validation": "existing active Salesforce User"},
    {"source": "riskLevel", "target": "Risk_Level__c", "required": false, "humanValidated": true},
    {"source": "specialTermsRiskNotes", "target": "Special_Terms_Risk_Notes__c", "required": false},
    {"source": "boxFolderId", "target": "Box_Workspace_Folder_ID__c", "required": true, "validation": "digits only and allowlisted workspace"},
    {"source": "boxFolderUrl", "target": "Box_Workspace_URL__c", "required": true, "validation": "${box.hostname} URL"},
    {"source": "boxIntakeFileId", "target": "Box_Intake_File_ID__c", "required": true, "validation": "digits only"},
    {"source": "boxRedlineFileId", "target": "Box_Redline_File_ID__c", "required": false, "validation": "digits only"},
    {"source": "workflowRunId", "target": "Intake_Workflow_Run_ID__c", "required": true},
    {"source": "recordSource", "target": "Record_Source__c", "required": true, "default": "Box Form"},
    {"source": "routingStatus", "target": "Latest_Routing_Status__c", "required": false, "default": "Not Started"},
    {"source": "openReviewTaskCount", "target": "Open_Review_Task_Count__c", "required": false, "default": 0},
    {"source": "lastBoxSync", "target": "Last_Box_Sync__c", "required": false}
  ],
  "security": {
    "browserWritableFields": [],
    "integrationWritableFields": "Only targets in fieldMappings",
    "documentsRemainIn": "Box",
    "prohibited": ["contract file bytes", "Box access tokens", "connector secrets", "unreviewed AI output"]
  }
}
