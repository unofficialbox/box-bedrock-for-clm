{
  "schemaVersion": "2.0",
  "strategy": "Group findings for the same contract, file, and domain into one human-owned Box task.",
  "confidenceThreshold": 0.85,
  "fallback": {
    "directoryKey": "legal-operations-triage",
    "displayName": "Legal Operations Triage",
    "boxLogin": "${box.reviewers.primary}",
    "rule": "Use for unclassified findings, confidence below threshold, missing experts, or experts without file access."
  },
  "routes": [
    {"domain": "Commercial Legal", "directoryKey": "commercial-counsel", "displayName": "Jordan Lee", "title": "Commercial Counsel", "boxLogin": "${box.reviewers.primary}"},
    {"domain": "Finance", "directoryKey": "finance-director", "displayName": "Priya Shah", "title": "Finance Director", "boxLogin": "${box.reviewers.primary}"},
    {"domain": "Privacy", "directoryKey": "privacy-counsel", "displayName": "Elena Torres", "title": "Privacy Counsel", "boxLogin": "${box.reviewers.primary}"},
    {"domain": "Security", "directoryKey": "security-lead", "displayName": "Marcus Reed", "title": "Security Assurance Lead", "boxLogin": "${box.reviewers.primary}"},
    {"domain": "Tax", "directoryKey": "tax-counsel", "displayName": "Tax Counsel", "title": "Tax Reviewer", "boxLogin": "${box.reviewers.primary}"},
    {"domain": "Service and SLA", "directoryKey": "service-owner", "displayName": "Service Owner", "title": "Service Delivery Owner", "boxLogin": "${box.reviewers.primary}"},
    {"domain": "Insurance", "directoryKey": "risk-manager", "displayName": "Risk Manager", "title": "Corporate Risk Manager", "boxLogin": "${box.reviewers.primary}"}
  ],
  "activationRules": [
    "Replace shared demo reviewer bindings with real domain experts when available.",
    "Verify each selected expert can access the redline before creating a task.",
    "Never infer a person or login from document text.",
    "Do not create more than one open task for the same contract, file, and domain."
  ]
}
