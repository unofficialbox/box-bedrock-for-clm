{
  "endpoint": "/app-api/graphql",
  "authentication": "existing authenticated Box Automate page client",
  "requests": [
    {
      "operationName": "CreateItemV2",
      "variables": {
        "input": {
          "name": "CLM Surface API Lab - Automate Workflow",
          "type": "workflow",
          "data": {"workflow": {"description": "<lab-description>", "trigger": null, "outcomes": [], "gateways": [], "edges": []}}
        }
      }
    },
    {
      "operationName": "UpdateItemV2",
      "variables": {
        "workflow": {"id": "${LAB_WORKFLOW_ID}", "name": "<lab-name>", "description": "<lab-description>", "trigger": null, "outcomes": [], "gateways": [], "edges": []},
        "itemV2": {"id": "${LAB_WORKFLOW_ID}", "name": "<lab-name>", "type": "workflow"},
        "itemIdentity": {"id": "${LAB_WORKFLOW_ID}", "name": "<lab-name>", "type": "workflow"},
        "includeItemIdentity": true
      }
    }
  ],
  "antiForgeryTokenExported": false,
  "deleteAttempted": false,
  "publishAttempted": false,
  "activateAttempted": false,
  "shareAttempted": false,
  "runAttempted": false
}
