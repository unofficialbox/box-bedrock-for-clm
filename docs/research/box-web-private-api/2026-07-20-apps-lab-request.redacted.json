{
  "hostname": "${BOX_WEB_HOST}",
  "authentication": "existing authenticated Box web-app session",
  "requests": [
    {"method": "POST", "path": "/app-api/crooze/call-meteor-method/v1/app.list", "arguments": []},
    {"method": "POST", "path": "/app-api/crooze/call-meteor-method/v1/app.create", "arguments": [{"name": "CLM Surface API Lab - Apps Workspace", "initialPageName": "Lab Overview"}]},
    {"method": "POST", "path": "/app-api/crooze/call-meteor-method/v1/app.get", "arguments": ["${LAB_APP_ID}"]},
    {"method": "POST", "path": "/app-api/crooze/call-meteor-method/v1/app.lock", "arguments": ["${LAB_APP_ID}"]},
    {
      "method": "POST",
      "path": "/app-api/crooze/call-meteor-method/v1/app.update.all",
      "arguments": [{
        "_id": "${LAB_APP_ID}",
        "name": "CLM Surface API Lab - Apps Workspace",
        "description": "Unsupported private API experiment. Do not use for production.",
        "pages": [{"_id": "${LAB_PAGE_ID}", "name": "Lab Overview", "sections": [], "items": []}],
        "fromVersion": 0
      }]
    },
    {"method": "POST", "path": "/app-api/crooze/call-meteor-method/v1/app.cancelEdit", "arguments": ["${LAB_APP_ID}"]}
  ],
  "productionAppTargeted": false,
  "deleteAttempted": false,
  "publishAttempted": false,
  "shareAttempted": false
}
