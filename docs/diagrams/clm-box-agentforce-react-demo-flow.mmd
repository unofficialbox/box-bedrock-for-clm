flowchart TD
    Start(["Submit New Contract Request"]) --> Automate["Box Automate<br/>Extract and Box Agent review"]
    Automate --> IntakeGate{"Human validates<br/>intake enrichment?"}
    IntakeGate -- "No" --> IntakeRework["Return for correction"]
    IntakeRework --> Start
    IntakeGate -- "Yes" --> CreateRecord["HTTPS connector<br/>standard REST upsert + lookup"]
    CreateRecord --> RecordGate{"Salesforce record ID<br/>returned?"}
    RecordGate -- "No" --> IntegrationReview["Keep Box request<br/>queue connector retry"]
    IntegrationReview --> CreateRecord
    RecordGate -- "Yes" --> React["React CLM workspace<br/>Salesforce record + Box context"]
    React --> BoxEvidence["Box workspace<br/>files, versions, metadata"]
    BoxEvidence --> Hub["Box Hub<br/>approved Markdown clauses"]
    Hub --> AgentReview["Agentforce review<br/>summary, citations, redline comparison"]
    AgentReview --> Findings["Structured redline findings<br/>before, after, fallback, risk"]
    Findings --> Route{"Domain and confidence<br/>route is valid?"}
    Route -- "No" --> Triage["Legal Operations triage<br/>unclassified or low confidence"]
    Triage --> Tasks
    Route -- "Yes" --> Tasks["One Box review task per domain<br/>named expert assignment"]
    Tasks --> Gate{"All named human<br/>approvals complete?"}
    Gate -- "No" --> Blocked["Signature blocked<br/>Agentforce explains next actions"]
    Blocked --> Tasks
    Gate -- "Yes" --> MemoConfirm{"Confirm DocGen<br/>draft creation?"}
    MemoConfirm -- "No" --> NoDraft(["No draft created<br/>remain approval-ready"])
    MemoConfirm -- "Yes" --> DocGen["Box DocGen<br/>approval memo"]
    DocGen --> Sign["Box Sign<br/>execution packet"]
    Sign --> Executed["Executed agreement<br/>in Box"]
    Executed --> Obligations["Agentforce extracts candidate obligations<br/>human validates owners and dates"]
    Obligations --> Finish(["Governed renewal and obligation tracking"])

    classDef surface fill:#e9f1ff,stroke:#1166e8,color:#071b33,stroke-width:2px
    classDef box fill:#f8fafc,stroke:#627a98,color:#071b33
    classDef decision fill:#fff1d6,stroke:#b16a00,color:#522f00,stroke-width:2px
    classDef blocked fill:#ffe8eb,stroke:#c63846,color:#7c1621,stroke-width:2px
    classDef terminal fill:#e7f7ec,stroke:#368453,color:#174a2b

    class React,AgentReview surface
    class Automate,CreateRecord,BoxEvidence,Hub,Findings,Tasks,DocGen,Sign,Executed,Obligations box
    class IntakeGate,RecordGate,Route,Gate,MemoConfirm decision
    class IntakeRework,IntegrationReview,Triage,Blocked blocked
    class Start,NoDraft,Finish terminal
