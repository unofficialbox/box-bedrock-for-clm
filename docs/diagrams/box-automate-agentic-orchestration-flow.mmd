flowchart LR
    App["Box App<br/>portfolio and actions"] --> Intake["Box Intake folder<br/>upload + clmContract metadata"]
    Intake --> Automate["Box Automate<br/>workflow coordinator"]
    Automate --> Extract["Extract Agent<br/>draft structured evidence"]
    Extract --> Review["Box and Agentforce agents<br/>source-grounded review"]
    Review --> Gate{"Human validation"}
    Gate -- "Reject" --> Rework["Return for correction"]
    Rework --> Intake
    Gate -- "Approve" --> Connector["HTTPS Connector<br/>Salesforce REST create (POST)"]
    Connector --> Tasks["Box tasks, metadata,<br/>Doc Gen and Sign"]
    Hub["Approved Clause Hub"] --> Review

    classDef box fill:#e9f1ff,stroke:#1166e8,color:#071b33
    classDef human fill:#fff1d6,stroke:#b16a00,color:#522f00
    class App,Intake,Automate,Extract,Review,Connector,Tasks,Hub box
    class Gate,Rework human
