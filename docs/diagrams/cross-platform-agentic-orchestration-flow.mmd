flowchart LR
    Event["Box or Salesforce event"] --> Supervisor["AgentCore Strands supervisor<br/>plan, memory and trace"]
    Supervisor --> BoxAgent["Box package and clause agents"]
    Supervisor --> SFAgent["Salesforce Agentforce specialists"]
    Supervisor --> DBXAgent["Databricks analytics agent"]
    BoxAgent --> Evidence["Governed files, metadata,<br/>tasks and citations"]
    SFAgent --> Record["CLM record, commercial truth<br/>and approval context"]
    DBXAgent --> Benchmarks["Historical outcomes<br/>and cycle-time benchmarks"]
    Evidence --> React["Salesforce Multi-Framework React<br/>CLM workspace"]
    Record --> React
    Benchmarks --> React
    React --> Gate{"Human approvals complete?"}
    Gate -- "No" --> Block["Block signature and route experts"]
    Block --> Supervisor
    Gate -- "Yes" --> Finish["Box Doc Gen, Sign,<br/>obligations and audit"]

    classDef agent fill:#eee9ff,stroke:#6b46c1,color:#24134f
    classDef system fill:#e9f1ff,stroke:#1166e8,color:#071b33
    classDef human fill:#fff1d6,stroke:#b16a00,color:#522f00
    class Supervisor,BoxAgent,SFAgent,DBXAgent agent
    class Event,Evidence,Record,Benchmarks,React,Finish system
