flowchart TB
  intake["Contract intake event<br/>Box Form or Salesforce opportunity"]

  subgraph agentcore["AWS Bedrock AgentCore"]
    supervisor["CLM Supervisor Agent<br/>Strands orchestration"]
    intakeAgent["Intake Agent"]
    boxAgent["Box Contract Package Agent"]
    riskAgent["Clause Risk Agent"]
    sfAgent["Salesforce Commercial Agent"]
    approvalAgent["Salesforce Approval Agent"]
    dbxAgent["Databricks Analytics Agent"]
    obligationAgent["Obligation Monitor Agent"]
    guardrails["Guardrails, Memory, Traces"]
  end

  subgraph box["Box - unstructured data"]
    boxContent["Contracts, redlines, exhibits"]
    boxMetadata["Metadata, tasks, versions"]
    boxSign["Box Sign package"]
  end

  subgraph salesforce["Salesforce - structured data"]
    opportunity["Opportunity, account, quote"]
    approvals["Approval records and tasks"]
    renewal["Renewal and owner records"]
  end

  subgraph databricks["Databricks - analytics"]
    outcomes["Historical clause outcomes"]
    benchmarks["Cycle-time and pricing benchmarks"]
    riskSignals["Renewal and risk signals"]
  end

  intake --> supervisor
  supervisor --> intakeAgent
  supervisor --> boxAgent
  supervisor --> riskAgent
  supervisor --> sfAgent
  supervisor --> approvalAgent
  supervisor --> dbxAgent
  supervisor --> obligationAgent
  supervisor --- guardrails

  intakeAgent --> boxContent
  boxAgent <--> boxContent
  boxAgent <--> boxMetadata
  riskAgent --> boxContent
  sfAgent <--> opportunity
  approvalAgent <--> approvals
  dbxAgent <--> outcomes
  dbxAgent <--> benchmarks
  dbxAgent <--> riskSignals
  obligationAgent --> boxMetadata
  obligationAgent --> renewal

  approvalAgent --> boxSign
  guardrails -. blocks signature until approvals complete .-> boxSign

  classDef agent fill:#e0f2fe,stroke:#0369a1,color:#0f172a
  classDef box fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
  classDef sf fill:#dcfce7,stroke:#15803d,color:#0f172a
  classDef dbx fill:#ffedd5,stroke:#c2410c,color:#0f172a
  classDef control fill:#f1f5f9,stroke:#64748b,color:#0f172a

  class supervisor,intakeAgent,boxAgent,riskAgent,sfAgent,approvalAgent,dbxAgent,obligationAgent agent
  class boxContent,boxMetadata,boxSign box
  class opportunity,approvals,renewal sf
  class outcomes,benchmarks,riskSignals dbx
  class intake,guardrails control
